    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 201,
      "title": "Trace Timeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Waterfall / Gantt chart view of all spans within the selected trace. Shows parent-child relationships, durations, and span kinds (task, llm_call, tool_call, reasoning, planning, retrieval, agent_comm).",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "id": 7,
      "options": {},
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" }",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 2000,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "title": "Trace Waterfall",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 202,
      "title": "Span Details",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "All spans in the trace with key attributes: name, span kind (task/llm_call/tool_call/reasoning/planning/retrieval/agent_comm), duration in ms, status, and agent name.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": true
          },
          "mappings": [
            {
              "options": {
                "error": { "color": "red", "index": 0, "text": "ERROR" },
                "ok": { "color": "green", "index": 1, "text": "OK" },
                "unset": { "color": "blue", "index": 2, "text": "UNSET" },
                "timeout": { "color": "orange", "index": 3, "text": "TIMEOUT" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "spanID" },
            "properties": [
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "span.name" },
            "properties": [
              { "id": "custom.width", "value": 250 },
              { "id": "displayName", "value": "Span Name" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "span.kind" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "displayName", "value": "Kind" },
              { "id": "custom.cellOptions", "value": {
                "type": "color-text"
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "duration" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "ms" },
              { "id": "displayName", "value": "Duration (ms)" },
              { "id": "custom.cellOptions", "value": {
                "type": "color-background",
                "mode": "gradient"
              }},
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 1000 },
                  { "color": "orange", "value": 3000 },
                  { "color": "red", "value": 10000 }
                ]
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "displayName", "value": "Status" },
              { "id": "custom.cellOptions", "value": {
                "type": "color-text"
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "span.agent.name" },
            "properties": [
              { "id": "custom.width", "value": 150 },
              { "id": "displayName", "value": "Agent" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "parentSpanID" },
            "properties": [
              { "id": "custom.width", "value": 130 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "enablePagination": true,
          "fields": [],
          "reducer": ["count"],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          { "desc": false, "displayName": "Duration (ms)" }
        ]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" } | select(span.name, span.kind, duration, status, span.agent.name, parentSpanID)",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 2000,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "Span Details Table",
      "type": "table"
    },
    {
      "collapsed": false,
