  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AgentTelemetry trace detail dashboard - deep dive into individual traces, spans, LLM calls, tool invocations, and inter-agent communication.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Agent Overview",
      "tooltip": "Back to agent overview dashboard",
      "type": "link",
      "url": "/d/agent-overview/agenttelemetry-agent-overview"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Trace Summary",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Total number of spans in the selected trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["count"],
          "fields": "/^spanID$/",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" } | select(span.spanID)",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 1000,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "Span Count",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Number of LLM call spans in the selected trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["count"],
          "fields": "/^spanID$/",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" && span.kind = \"llm_call\" }",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 1000,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "LLM Calls in Trace",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Number of tool call spans in the selected trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["count"],
          "fields": "/^spanID$/",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" && span.kind = \"tool_call\" }",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 1000,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "Tool Calls in Trace",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Number of error spans in the selected trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["count"],
          "fields": "/^spanID$/",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" && status = error }",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 1000,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "Errors in Trace",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Total trace duration in milliseconds (root span duration).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 30000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["max"],
          "fields": "/^duration$/",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" && span.kind = \"task\" } | select(duration)",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 100,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "Trace Duration",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Total estimated cost of all LLM calls within this trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "$0.0000",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "red", "value": 1.00 }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "/^llm\\.cost_usd$/",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ rootServiceName=~\"$agent_name\" && span.kind = \"llm_call\" } | select(span.llm.cost_usd)",
          "filters": [
            {
              "id": "trace-id",
              "tag": "traceID",
              "operator": "=",
              "value": ["$trace_id"],
              "valueType": "string",
              "scope": "intrinsic"
            }
          ],
          "limit": 1000,
          "tableType": "spans",
          "refId": "A"
        }
      ],
      "title": "Trace Total Cost",
      "type": "stat"
