diff --git a/model/gen-ai/spans.yaml b/model/gen-ai/spans.yaml
index 2ff5f5c..5c1d917 100644
--- a/model/gen-ai/spans.yaml
+++ b/model/gen-ai/spans.yaml
@@ -516,3 +516,50 @@ groups:
         requirement_level: opt_in
       - ref: gen_ai.output.messages
         requirement_level: opt_in
+
+  - id: span.gen_ai.plan.internal
+    type: span
+    span_kind: internal
+    stability: development
+    brief: >
+      Describes an agent planning or task decomposition phase.
+    note: |
+      The `gen_ai.operation.name` MUST be `plan`.
+
+      **Span name** SHOULD be `plan {gen_ai.agent.name}`.
+      If `gen_ai.agent.name` is not available, the span name SHOULD be `plan`.
+
+      A plan span represents the decision phase where an agent formulates
+      a strategy before executing it. It is a child of `invoke_agent` and
+      a sibling of `execute_tool` and `chat` spans under the same agent.
+      The LLM call that generates the plan is a child of the plan span.
+
+      This parent-child relationship captures the causal link between the
+      planning decision and the LLM call that produces it. Modeling planning
+      as a task attribute or a grouping tag (see issue #3575) would collapse
+      this hierarchy and lose the ability to measure planning duration
+      independently.
+
+      This is distinct from a task (issue #2912): a plan formulates strategy;
+      a task executes assigned work. A plan span may be the parent of
+      task or tool spans it generates.
+    attributes:
+      - ref: gen_ai.operation.name
+        requirement_level: required
+        sampling_relevant: true
+      - ref: gen_ai.system
+        requirement_level: required
+      - ref: gen_ai.agent.name
+        requirement_level:
+          recommended: if available
+        sampling_relevant: true
+      - ref: gen_ai.agent.id
+        requirement_level:
+          recommended: if available
+      - ref: error.type
+        requirement_level:
+          conditionally_required: "if the operation ended in an error"
+        note: |
+          The `error.type` SHOULD match the error code returned by the Generative AI provider or the client library,
+          the canonical name of exception that occurred, or another low-cardinality error identifier.
+          Instrumentations SHOULD document the list of errors they report.
